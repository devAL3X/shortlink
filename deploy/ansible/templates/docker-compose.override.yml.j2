# Переопределение публикации портов для VDS (docker compose объединяет этот файл
# с docker-compose.yml автоматически, если он лежит рядом и называется override).
#
# Главная причина: docker публикует порты через собственные iptables-правила
# и ОБХОДИТ ufw. Поэтому единственный надёжный способ ничего не торчало наружу —
# привязать порты к loopback. Наружу смотрит только nginx (:80).
services:
  frontend:
    ports: !override
      - "127.0.0.1:8080:8080"

  rabbitmq1:
    ports: !override
      - "127.0.0.1:15672:15672"   # management UI — только с самого сервера (ssh -L)
