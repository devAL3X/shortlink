# shortlink: nginx — единственная точка входа.
#
# Схема входа без user:pass@ (Chrome её не поддерживает для fetch):
#   1. Первый запрос без cookie → basic auth (диалог браузера, один раз).
#   2. После входа каждый защищённый ответ несёт Set-Cookie slauth=<token>.
#   3. Дальше map подставляет в auth_basic значение "off" — cookie заменяет пароль.
# Cookie HttpOnly (JS не читает), 7 дней. Публично только /r/ — и токен
# по коротким ссылкам НЕ выдаётся.
map_hash_bucket_size 128;   # 64-символьный токен не влезает в дефолтные 64 байта
map $cookie_slauth $auth_realm {
    default   "shortlink";   # нет/неверный токен → basic auth
    "{{ auth_cookie_token }}" "off";   # валидный токен → авторизация не нужна
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    server_tokens off;

    auth_basic $auth_realm;
    auth_basic_user_file /etc/nginx/.htpasswd.shortlink;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    location /api/ {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
        add_header Set-Cookie "slauth={{ auth_cookie_token }}; Path=/; Max-Age=604800; HttpOnly; SameSite=Lax";
        proxy_pass http://127.0.0.1:8080;
    }

    location = /healthz {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
        add_header Set-Cookie "slauth={{ auth_cookie_token }}; Path=/; Max-Age=604800; HttpOnly; SameSite=Lax";
        proxy_pass http://127.0.0.1:8080;
    }

    location = /hello {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
        add_header Set-Cookie "slauth={{ auth_cookie_token }}; Path=/; Max-Age=604800; HttpOnly; SameSite=Lax";
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
        add_header Set-Cookie "slauth={{ auth_cookie_token }}; Path=/; Max-Age=604800; HttpOnly; SameSite=Lax";
        proxy_pass http://127.0.0.1:8080;
    }

    # короткие ссылки — публичные 302, токен НЕ выдаётся
    location /r/ {
        auth_basic off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
        proxy_pass http://127.0.0.1:8080;
    }
}
